# UNO Q host development configuration.
# This file is sourced by scripts/unoq/*.sh. Keep values as shell assignments.

UNOQ_PYTHON="python3"
UNOQ_VENV_DIR="${HOME}/blemidi"
UNOQ_REQUIREMENTS="m3/requirements.txt"
UNOQ_RECEIVER_MODULE="m3.receiver"

# A proven App Lab app copied from "Blink LED from Python" is the deployment
# target. app.yaml and sketch/sketch.yaml stay owned by App Lab and are never
# overwritten by these scripts.
UNOQ_APP_DIR="/home/arduino/ArduinoApps/m3-ble-to-led"
UNOQ_APP_SOURCE_DIR="experiments/m3_app"
UNOQ_DEPLOY_FILES="python/main.py python/led_relay.py sketch/sketch.ino"
UNOQ_RELAY_SOCKET="${UNOQ_APP_DIR}/m3-led.sock"
UNOQ_APP_START_MODE="cli"

UNOQ_BLE_ADDRESS="9C:C3:94:81:01:53"
UNOQ_BLE_MIDI_SERVICE_UUID="03b80e5a-ede8-4b33-a751-6ce34ec4c700"
UNOQ_BLE_MIDI_CHARACTERISTIC_UUID="7772e5db-3868-4112-a1a9-f2669d106bf3"
UNOQ_WAIT_SECONDS="120"
UNOQ_BLE_PROBE_SECONDS="10"

# Normal runs do not require network access. Set to 1, or pass --update, when
# run.sh should call the safe fast-forward-only update step first.
UNOQ_UPDATE_ON_RUN="0"
